# Copy this file to .env and add your key to turn on the advisor chat.
# Without a key, the app uses the guided form instead.
GROQ_API_KEY=your-groq-api-key

# The same key turns on the advisor's microphone (speech to text). These are the defaults.
# VOICE_MODEL=whisper-large-v3
# VOICE_BACKUP_MODEL=whisper-large-v3-turbo

# Sign-in cookies are Secure, so they need HTTPS (localhost is allowed).
# Set this to false only to test over plain HTTP on another address.
# COOKIE_SECURE=true
